# ============================================
# 🚫 AI-Agent Scaffold — .gitignore
# ============================================

# ── Dependencies ──
node_modules/
vendor/
.venv/
venv/
__pycache__/
*.pyc

# ── Environment ──
.env
.env.local
.env.*.local
!.env.example

# ── Build Output ──
dist/
build/
out/
.next/
.nuxt/
.output/
*.egg-info/

# ── IDE & Editor ──
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Testing ──
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ── Claude Code Local Overrides ──
.claude/CLAUDE.local.md
.claude/settings.local.json

# ── OS Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ── Temp ──
tmp/
temp/
*.tmp
*.bak
